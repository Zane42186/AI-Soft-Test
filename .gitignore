# 忽略：个人本地配置文件（含密钥/本地路径）
.claude/settings.local.json

# 忽略：IDE 锁文件（运行时生成）
.claude/ide/

# 忽略：会话记录（运行时生成）
.claude/sessions/
.claude/session-env/
.claude/projects/
.claude/file-history/
.claude/shell-snapshots/

# 忽略：守护进程文件
.claude/daemon/

# 忽略：备份
.claude/backups/

# 忽略：遥测数据
.claude/telemetry/

# 忽略：历史记录
.claude/history.jsonl
.claude/.last-cleanup

# 忽略：临时/缓存文件
*.tmp
*.swp
.cache/
